{
	"name": "vscode-bun-dependency",
	"displayName": "vscode-bun-dependency",
	"version": "0.0.1",
	"description": "Update dependencies/devDependencies for specific package.json with bun and execute scripts.",
	"categories": [
		"Other"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/involvex/vscode-bun-dependency.git"
	},
	"author": "involvex",
	"publisher": "involvex",
	"main": "./out/extension.js",
	"scripts": {
		"check": "bun run format && bun run lint:fix && bun run typecheck",
		"clean": "bunx del-cli dist",
		"compile": "tsc -p ./",
		"format": "prettier . --write",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"package": "bunx @vscode/vsce package --no-dependencies -o ./dist/ --skip-license",
		"pretest": "bun run compile && bun run lint",
		"test": "vscode-test",
		"typecheck": "tsc --noEmit",
		"vscode:prepublish": "bun run clean && bun run check && bunx mkdirp dist && bun run compile",
		"watch": "tsc -watch -p ./"
	},
	"contributes": {
		"commands": [
			{
				"command": "vscode-bun-dependency.refresh",
				"title": "Refresh Dependencies",
				"category": "Bun",
				"icon": "$(refresh)"
			},
			{
				"command": "vscode-bun-dependency.checkOutdated",
				"title": "Check for Outdated Packages",
				"category": "Bun",
				"icon": "$(sync)"
			},
			{
				"command": "vscode-bun-dependency.updateAll",
				"title": "Update All Packages",
				"category": "Bun",
				"icon": "$(cloud-download)"
			},
			{
				"command": "vscode-bun-dependency.updatePackage",
				"title": "Update Package",
				"category": "Bun",
				"icon": "$(arrow-up)"
			},
			{
				"command": "vscode-bun-dependency.updatePackageLatest",
				"title": "Update Package to Latest",
				"category": "Bun"
			},
			{
				"command": "vscode-bun-dependency.removePackage",
				"title": "Remove Package",
				"category": "Bun",
				"icon": "$(trash)"
			},
			{
				"command": "vscode-bun-dependency.addPackage",
				"title": "Add Package",
				"category": "Bun",
				"icon": "$(add)"
			},
			{
				"command": "vscode-bun-dependency.openSearch",
				"title": "Search Packages to Install",
				"category": "Bun",
				"icon": "$(search)"
			},
			{
				"command": "vscode-bun-dependency.runScript",
				"title": "Run Script",
				"category": "Bun",
				"icon": "$(play)"
			},
			{
				"command": "vscode-bun-dependency.refreshScripts",
				"title": "Refresh Scripts",
				"category": "Bun",
				"icon": "$(refresh)"
			},
			{
				"command": "vscode-bun-dependency.selectPackage",
				"title": "Select package.json",
				"category": "Bun",
				"icon": "$(file)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "vscode-bun-dependency.refresh",
					"when": "view == bunDependencies",
					"group": "navigation@1"
				},
				{
					"command": "vscode-bun-dependency.checkOutdated",
					"when": "view == bunDependencies",
					"group": "navigation@2"
				},
				{
					"command": "vscode-bun-dependency.updateAll",
					"when": "view == bunDependencies",
					"group": "navigation@3"
				},
				{
					"command": "vscode-bun-dependency.addPackage",
					"when": "view == bunDependencies",
					"group": "navigation@4"
				},
				{
					"command": "vscode-bun-dependency.openSearch",
					"when": "view == bunDependencies"
				},
				{
					"command": "vscode-bun-dependency.selectPackage",
					"when": "view == bunDependencies",
					"group": "navigation@5"
				},
				{
					"command": "vscode-bun-dependency.refreshScripts",
					"when": "view == bunScripts",
					"group": "navigation@1"
				},
				{
					"command": "vscode-bun-dependency.selectPackage",
					"when": "view == bunScripts",
					"group": "navigation@2"
				}
			],
			"view/item/context": [
				{
					"command": "vscode-bun-dependency.updatePackage",
					"when": "view == bunDependencies && viewItem == outdatedPackage",
					"group": "inline@1"
				},
				{
					"command": "vscode-bun-dependency.updatePackageLatest",
					"when": "view == bunDependencies && viewItem == outdatedPackage",
					"group": "1_update@1"
				},
				{
					"command": "vscode-bun-dependency.updatePackage",
					"when": "view == bunDependencies && viewItem == outdatedPackage",
					"group": "1_update@2"
				},
				{
					"command": "vscode-bun-dependency.removePackage",
					"when": "view == bunDependencies && viewItem =~ /^outdatedPackage$|^package$/",
					"group": "2_delete@1"
				},
				{
					"command": "vscode-bun-dependency.runScript",
					"when": "view == bunScripts && viewItem == bunScript",
					"group": "inline@1"
				}
			]
		},
		"views": {
			"bun-explorer": [
				{
					"id": "bunDependencies",
					"name": "Dependencies",
					"icon": "media/bun.svg"
				},
				{
					"id": "bunScripts",
					"name": "Bun Scripts",
					"icon": "media/bun.svg"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "bun-explorer",
					"title": "Bun Dependencies",
					"icon": "media/bun.svg"
				}
			]
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"prettier": "@involvex/prettier-config",
	"overrides": {
		"diff": "^8.0.4",
		"serialize-javascript": "^7.0.6"
	},
	"devDependencies": {
		"@involvex/prettier-config": "^0.0.6",
		"@types/mocha": "^10.0.10",
		"@types/node": "24.x",
		"@types/vscode": "^1.136.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.0.0",
		"eslint": "^10.5.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	},
	"engines": {
		"vscode": "^1.136.0"
	}
}
